# Основные настройки Django
DEBUG=True
SECRET_KEY=your-super-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Подключение к базе данных (для Django)
DATABASE_NAME=eduflow
DATABASE_HOST=db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password
DATABASE_PORT=5432

# Данные для инициализации PostgreSQL (для Docker-образа)
POSTGRES_DB=eduflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# Ключи Stripe (тестовый режим)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Брокер и backend для Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Настройки SMTP для отправки писем (например, Yandex)
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=your_email@yandex.ru
EMAIL_HOST_PASSWORD=your_app_password